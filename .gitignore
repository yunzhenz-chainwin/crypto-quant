.venv/
__pycache__/
*.py[cod]

.env
.env.*
*.log

.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

*.egg-info/
build/
dist/

# 前端依賴與建置產物
frontend/node_modules/
frontend/dist/

# 動態產生的資料（頻繁變動，不追蹤）
data/raw/
data/clean/
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/

# 後端執行期資料庫（app.db 等，執行時產生，勿提交）
backend/*.db
backend/*.db-wal
backend/*.db-shm

# 執行期／研究重跑報表（可由資料與程式重建，不追蹤）
# reports/*.md 可作為人工審閱文件追蹤；固定測試資料請放 tests/fixtures/。
reports/*.csv
reports/*.json
reports/*.png
reports/validation_*.txt
reports/crosscheck_*.txt

# Claude 工作階段記憶(非專案程式)
memory/

# 本機密鑰載入檔（後台帳密，勿提交）。.cmd = Windows，.sh = macOS/Linux
*.local.cmd
*.local.sh

# macOS 檔案總管產生的垃圾
.DS_Store

# Word 開檔鎖定檔與 docs/src 的臨時轉檔產物；只提交 crypto-quant_交接手冊.docx、
# crypto-quant_系統規格書.docx（由 scripts/build_docs.py 重生）與手工來源 情緒詞庫範本.docx
docs/~$*.docx
docs/src/_*.docx
docs/AI機器人固定問答範本.docx
